# ---------------------------------------------------------------------------
# SamaPiece — variables d'environnement pour docker-compose (développement).
# Copier ce fichier en .env (cp .env.example .env) avant `docker-compose up`.
# Ne jamais committer .env (déjà ignoré par .gitignore) ; .env.example, lui,
# doit toujours être commité et tenu à jour.
# ---------------------------------------------------------------------------

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_HOST_PORT=8080

# --- Frontend (nginx) ---
FRONTEND_HOST_PORT=8081
# Nom d'hote interne du backend pour le proxy nginx (location /api/ de
# nginx.conf.template). Valeur specifique a docker-compose (nom du service
# `backend` sur le reseau Docker par defaut) ; Render fournit sa propre
# valeur via `fromService` dans render.yaml, ne pas reutiliser cette valeur
# en dehors de docker-compose.
BACKEND_HOST=backend

# --- PostgreSQL ---
# NOTE: non consommé par le backend dans ce ticket (voir README / spec) ;
# posé ici pour préparer le ticket futur qui réintroduira JPA/Flyway.
DB_NAME=samapiece_dev
DB_USER=samapiece
DB_PASSWORD=samapiece_dev_password
DB_PORT=5432
POSTGRES_HOST_PORT=5432

# --- Redis ---
REDIS_HOST_PORT=6379

# --- Meilisearch ---
MEILI_MASTER_KEY=samapiece_dev_master_key_change_me
MEILISEARCH_HOST_PORT=7700
MEILISEARCH_INDEX_PIECES=pieces

# --- MinIO ---
MINIO_ROOT_USER=samapiece_minio
MINIO_ROOT_PASSWORD=samapiece_minio_password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- MinIO : bucket photos (ticket #13) ---
MINIO_BUCKET_PHOTOS=samapiece-photos-dev

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=samapiece
RABBITMQ_DEFAULT_PASS=samapiece_rabbitmq_password
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# --- Authentification (JWT) ---
# Secret HMAC-SHA256, >= 32 caracteres (256 bits). Generer une valeur en local avec :
#   openssl rand -base64 32
# Ne jamais utiliser cette valeur d'exemple en staging/prod.
JWT_SECRET=changez_moi_avec_une_valeur_aleatoire_dau_moins_32_caracteres

# --- Chiffrement des photos (ticket #13) ---
# Cle AES-256 (32 octets) encodee en base64. Generer une valeur en local avec :
#   openssl rand -base64 32
# Ne jamais utiliser cette valeur d'exemple en staging/prod.
PHOTO_CLE_CHIFFREMENT=changez_moi_avec_une_cle_aes_256_generee_en_base64

# --- Passerelle SMS (ticket #21) ---
SMS_API_ENDPOINT=http://localhost:1
SMS_API_KEY=changez_moi_avec_la_cle_api_de_la_passerelle_sms
SMS_SENDER_ID=SamaPiece
SMS_TIMEOUT_MS=5000
SMS_MAX_TENTATIVES=3

# --- Alertes de recherche citoyenne (ticket #22) ---
# Cle AES-256 (32 octets) encodee en base64, distincte de PHOTO_CLE_CHIFFREMENT. Generer avec :
#   openssl rand -base64 32
# Ne jamais utiliser cette valeur d'exemple en staging/prod.
ALERTE_CLE_CHIFFREMENT=changez_moi_avec_une_cle_aes_256_generee_en_base64

# --- Suivi d'erreurs applicatif Sentry (ticket #28) ---
# Laisser vide en developpement local (aucun compte Sentry pour ce pilote) : le SDK backend
# (sentry-spring-boot-starter-jakarta) et le SDK frontend (@sentry/react) restent desactives
# (no-op) tant qu'aucun DSN n'est fourni.
SENTRY_DSN=
VITE_SENTRY_DSN=
